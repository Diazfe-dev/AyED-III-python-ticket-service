{
  "openapi": "3.1.0",
  "info": {
    "title": "Ticket Service API",
    "version": "0.1.0",
    "description": "JSON API of the support ticket management system."
  },
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness check",
        "operationId": "getHealth",
        "tags": ["platform"],
        "security": [],
        "responses": {
          "200": {
            "description": "The service is up.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  },
                  "required": ["status"]
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "OpenAPI contract of this API",
        "operationId": "getOpenApiContract",
        "tags": ["platform"],
        "security": [],
        "responses": {
          "200": {
            "description": "The OpenAPI 3.1 document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/docs": {
      "get": {
        "summary": "Swagger UI for this API",
        "operationId": "getApiDocs",
        "tags": ["platform"],
        "security": [],
        "responses": {
          "200": {
            "description": "HTML page that renders the contract with Swagger UI.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Start an authenticated session",
        "description": "Checks the credentials and stores the user in the signed session cookie. Any failure (unknown email, wrong password, inactive user or missing fields) gets the same generic answer.",
        "operationId": "login",
        "tags": ["auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated. The response sets the `session` cookie.",
            "headers": {
              "Set-Cookie": {
                "description": "Signed `session` cookie (HttpOnly, SameSite=Lax).",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionUser"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials (`invalid_credentials`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_credentials"
                }
              }
            }
          }
        }
      }
    },
    "/logout": {
      "post": {
        "summary": "End the current session",
        "operationId": "logout",
        "tags": ["auth"],
        "responses": {
          "204": {
            "description": "Session ended. The `session` cookie is cleared."
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          }
        }
      }
    },
    "/users": {
      "post": {
        "summary": "Create a user",
        "description": "Admin only. Creates an active user with the given role. The email is stored without surrounding spaces and in lowercase, and must not belong to any other user, active or not.",
        "operationId": "createUser",
        "tags": ["users"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/DuplicateEmail"
          }
        }
      }
    },
    "/users/{user_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UserId"
        }
      ],
      "patch": {
        "summary": "Update a user",
        "description": "Admin only. Changes the name, email or preferred channel of a user. Missing or `null` fields keep their value; any other key (such as `role`, `password` or `is_active`) is ignored. The fields sent are validated like on create.",
        "operationId": "updateUser",
        "tags": ["users"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/UserNotFound"
          },
          "409": {
            "$ref": "#/components/responses/DuplicateEmail"
          }
        }
      }
    },
    "/users/{user_id}/deactivate": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UserId"
        }
      ],
      "post": {
        "summary": "Deactivate a user",
        "description": "Admin only. Logical deletion: the user is marked inactive and kept with all its data and history. An inactive user cannot log in and its email stays reserved. An administrator cannot deactivate itself.",
        "operationId": "deactivateUser",
        "tags": ["users"],
        "responses": {
          "200": {
            "description": "User deactivated (`is_active` is `false`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/UserNotFound"
          },
          "409": {
            "description": "The administrator tried to deactivate itself (`self_deactivation`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "self_deactivation"
                }
              }
            }
          }
        }
      }
    },
    "/clients": {
      "get": {
        "summary": "List clients",
        "description": "Admin only. Every user with role `Client`, active or not, ordered by id.",
        "operationId": "listClients",
        "tags": ["users"],
        "responses": {
          "200": {
            "$ref": "#/components/responses/UserList"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/representatives": {
      "get": {
        "summary": "List representatives",
        "description": "Admin only. Every user with role `Representative`, active or not, ordered by id.",
        "operationId": "listRepresentatives",
        "tags": ["users"],
        "responses": {
          "200": {
            "$ref": "#/components/responses/UserList"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/categories": {
      "get": {
        "summary": "List categories",
        "description": "Any authenticated user. Every category, ordered by name without case.",
        "operationId": "listCategories",
        "tags": ["catalog"],
        "responses": {
          "200": {
            "description": "Every category, ordered by name.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          }
        }
      },
      "post": {
        "summary": "Create a category",
        "description": "Admin only. Creates a category (rubro). The name is required, must be text, is stored without surrounding spaces and must be unique without case.",
        "operationId": "createCategory",
        "tags": ["catalog"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Category created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/DuplicateCategory"
          }
        }
      }
    },
    "/categories/{category_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/CategoryId"
        }
      ],
      "patch": {
        "summary": "Rename a category",
        "description": "Admin only. A missing or `null` name keeps the current one; any other key is ignored. The name is validated like on create; renaming a category to its own name with other case is allowed.",
        "operationId": "updateCategory",
        "tags": ["catalog"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCategoryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Category updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/CategoryNotFound"
          },
          "409": {
            "$ref": "#/components/responses/DuplicateCategory"
          }
        }
      },
      "delete": {
        "summary": "Delete a category",
        "description": "Admin only. Physical deletion of a category without product types.",
        "operationId": "deleteCategory",
        "tags": ["catalog"],
        "responses": {
          "204": {
            "description": "Category deleted."
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/CategoryNotFound"
          },
          "409": {
            "$ref": "#/components/responses/CategoryInUse"
          }
        }
      }
    },
    "/product-types": {
      "get": {
        "summary": "List product types grouped by category",
        "description": "Any authenticated user. Without `category_id`, every category (empty ones included) ordered by name, each with its product types ordered by name. With `category_id`, a list with only that category's group.",
        "operationId": "listProductTypes",
        "tags": ["catalog"],
        "parameters": [
          {
            "name": "category_id",
            "in": "query",
            "required": false,
            "description": "Positive integer of an existing category. Anything else is `invalid` (`400`).",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Groups of product types.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoryWithProductTypes"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "404": {
            "$ref": "#/components/responses/CategoryNotFound"
          }
        }
      },
      "post": {
        "summary": "Create a product type",
        "description": "Admin only. Creates a product type in an existing category. `name` and `category_id` are validated together (`400`); then the category must exist (`404`) and the name must be free inside it (`409`).",
        "operationId": "createProductType",
        "tags": ["catalog"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductTypeRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product type created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductType"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/CategoryNotFound"
          },
          "409": {
            "$ref": "#/components/responses/DuplicateProductType"
          }
        }
      }
    },
    "/product-types/{product_type_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ProductTypeId"
        }
      ],
      "patch": {
        "summary": "Rename or move a product type",
        "description": "Admin only. Missing or `null` fields keep their value; any other key is ignored. The final name must be free in the target category, compared without case.",
        "operationId": "updateProductType",
        "tags": ["catalog"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProductTypeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Product type updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductType"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/ProductTypeOrCategoryNotFound"
          },
          "409": {
            "$ref": "#/components/responses/DuplicateProductType"
          }
        }
      },
      "delete": {
        "summary": "Delete a product type",
        "description": "Admin only. Physical deletion of a product type.",
        "operationId": "deleteProductType",
        "tags": ["catalog"],
        "responses": {
          "204": {
            "description": "Product type deleted."
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/ProductTypeNotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session",
        "description": "Signed Flask session cookie set by `POST /login`."
      }
    },
    "responses": {
      "AuthenticationRequired": {
        "description": "No authenticated session (`authentication_required`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "authentication_required"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The session user is not an administrator (`forbidden`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "forbidden"
            }
          }
        }
      },
      "ValidationFailed": {
        "description": "Some fields are missing or invalid (`validation_error`). `fields` lists every invalid field with its reason.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationErrorResponse"
            },
            "example": {
              "error": "validation_error",
              "fields": {
                "name": "required",
                "email": "invalid"
              }
            }
          }
        }
      },
      "DuplicateEmail": {
        "description": "The email already belongs to another user, active or not (`duplicate_email`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "duplicate_email"
            }
          }
        }
      },
      "UserNotFound": {
        "description": "No user has this id (`user_not_found`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "user_not_found"
            }
          }
        }
      },
      "UserList": {
        "description": "Users of the requested role, each with its role and state.",
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        }
      },
      "DuplicateCategory": {
        "description": "Another category already has this name, compared without case (`duplicate_category`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "duplicate_category"
            }
          }
        }
      },
      "CategoryNotFound": {
        "description": "No category has this id (`category_not_found`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "category_not_found"
            }
          }
        }
      },
      "CategoryInUse": {
        "description": "The category still has product types and cannot be deleted (`category_in_use`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "category_in_use"
            }
          }
        }
      },
      "DuplicateProductType": {
        "description": "The category already has a product type with this name, compared without case (`duplicate_product_type`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "duplicate_product_type"
            }
          }
        }
      },
      "ProductTypeOrCategoryNotFound": {
        "description": "No product type has this id (`product_type_not_found`), or the target category does not exist (`category_not_found`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "product_type_not_found"
            }
          }
        }
      },
      "ProductTypeNotFound": {
        "description": "No product type has this id (`product_type_not_found`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "product_type_not_found"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Machine-readable error code."
          }
        },
        "required": ["error"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Compared without surrounding spaces and case-insensitively."
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": ["email", "password"]
      },
      "SessionUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": ["id", "name", "email", "role"]
      },
      "Role": {
        "type": "string",
        "enum": ["Admin", "Representative", "Client"]
      },
      "PreferredChannel": {
        "type": "string",
        "enum": ["mail", "whatsapp"],
        "description": "Notification channel of the user."
      },
      "User": {
        "type": "object",
        "description": "A user as returned by the API. It never includes the password or its hash.",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "preferred_channel": {
            "$ref": "#/components/schemas/PreferredChannel"
          },
          "is_active": {
            "type": "boolean"
          }
        },
        "required": ["id", "name", "email", "role", "preferred_channel", "is_active"]
      },
      "CreateUserRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8
          },
          "preferred_channel": {
            "$ref": "#/components/schemas/PreferredChannel",
            "default": "mail"
          }
        },
        "required": ["name", "email", "role", "password"]
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "const": "validation_error"
          },
          "fields": {
            "type": "object",
            "description": "Invalid field name mapped to its reason.",
            "additionalProperties": {
              "type": "string",
              "enum": ["required", "invalid", "too_short"]
            }
          }
        },
        "required": ["error", "fields"]
      },
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "preferred_channel": {
            "$ref": "#/components/schemas/PreferredChannel"
          }
        }
      },
      "Category": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CategoryRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Category name. Stored without surrounding spaces; unique without case."
          }
        }
      },
      "UpdateCategoryRequest": {
        "type": "object",
